{
  "name": "ntplay",
  "version": "2.3.0",
  "description": "BOB Player - player de listas M3U/M3U8",
  "main": "electron/main.js",
  "author": "BOB",
  "scripts": {
    "vendor": "node -e \"const f=require('fs');f.mkdirSync('www/vendor',{recursive:true});f.copyFileSync('node_modules/hls.js/dist/hls.min.js','www/vendor/hls.min.js');f.copyFileSync('node_modules/mpegts.js/dist/mpegts.js','www/vendor/mpegts.js')\"",
    "postinstall": "npm run vendor",
    "pc": "electron .",
    "pc:build": "electron-builder --win nsis portable",
    "apk:init": "cap add android && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "hls.js": "1.5.7",
    "mpegts.js": "1.7.3"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.bob.player",
    "productName": "NTPlay",
    "files": ["electron/**", "www/**"],
    "fileAssociations": [{ "ext": ["m3u", "m3u8"], "name": "Lista M3U" }],
    "win": { "target": ["nsis", "portable"] }
  }
}
